# Environment Variables Example
# 
# For local development, copy this to .env and fill in your values.
# For production, use Docker environment variables or hosting platform secrets.
#
# NOTE: .env is gitignored. Never commit real credentials!

#────────────────────────────────────────
# Server Configuration
#────────────────────────────────────────
PORT=3000
NODE_ENV=development  # Set to "production" in production

#────────────────────────────────────────
# Google Cloud Vertex AI
#────────────────────────────────────────
# Path to service account JSON file (for Vertex AI access)
# For local development, use the included placeholder: ./service-account.json
# Replace with your actual service account JSON for Vertex AI access
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
PROJECT_ID=your-google-cloud-project-id
LOCATION=us-west1  # e.g., us-central1, europe-west1
RAG_CORPUS_ID=your-vertex-ai-rag-corpus-id

#────────────────────────────────────────
# Google OAuth (for user authentication)
#────────────────────────────────────────
# Register your app at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Local development:
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# FRONTEND_URL=http://localhost:3000

# Production:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
# FRONTEND_URL=https://yourdomain.com
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000

#────────────────────────────────────────
# Session & JWT Secrets
#────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-random-string-here
JWT_SECRET=generate-another-random-string-here

#────────────────────────────────────────
# MongoDB Database
#────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/dbname
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jessica-ai-local

#────────────────────────────────────────
# MongoDB Docker Credentials (for docker-compose.yml)
#────────────────────────────────────────
# For local development with Docker, set these to override default credentials
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example
