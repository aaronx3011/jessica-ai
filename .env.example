# Environment Variables Example
#
# For local development, copy this to .env and fill in your values.
# For production, use Docker environment variables or hosting platform secrets.
#
# NOTE: .env is gitignored. Never commit real credentials!

#────────────────────────────────────────
# Server Configuration
#────────────────────────────────────────
PORT=3000
NODE_ENV=development  # Set to "production" in production

#────────────────────────────────────────
# Google Cloud Vertex AI
#────────────────────────────────────────
# Path to service account JSON file (for Vertex AI access)
# For local development, use the included placeholder: ./service-account.json
# Replace with your actual service account JSON for Vertex AI access
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
PROJECT_ID=your-google-cloud-project-id
LOCATION=us-west1  # e.g., us-central1, europe-west1
